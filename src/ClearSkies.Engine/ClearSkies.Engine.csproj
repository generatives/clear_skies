<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClearSkies.Tests" />
    <InternalsVisibleTo Include="ClearSkies.Net" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepuPhysics" Version="2.4.0" />
    <PackageReference Include="DefaultEcs" Version="0.17.2" />
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="SharpGLTF.Toolkit" Version="1.0.7" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Maths" Version="2.23.0" />
    <PackageReference Include="Silk.NET.WebGPU" Version="2.23.0" />
    <PackageReference Include="Silk.NET.WebGPU.Extensions.WGPU" Version="2.23.0" />
    <PackageReference Include="Silk.NET.WebGPU.Native.WGPU" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <PackageReference Include="StbTrueTypeSharp" Version="1.26.13" />
  </ItemGroup>

  <!-- The native Clay library (UI layout, see native/clay/README.md), prebuilt per platform. Each platform's file has
       its own name (clay.dll, libclay.so, libclay.dylib), so all of them go straight into the output folder, where
       [DllImport("clay")] finds the right one; this also flows on to the game project's output. The exception is
       Windows, whose x64 and ARM64 builds are both clay.dll: the ARM64 one is used when building for win-arm64, or
       for no runtime identifier on an ARM64 machine. IsRidAgnostic=false makes a referencing project pass its runtime
       identifier down (dotnet publish -r win-arm64), which the SDK otherwise strips from library references. -->
  <PropertyGroup>
    <IsRidAgnostic>false</IsRidAgnostic>
    <ClayWindowsRid>win-x64</ClayWindowsRid>
    <ClayWindowsRid Condition="'$(RuntimeIdentifier)' == 'win-arm64' Or ('$(RuntimeIdentifier)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64')">win-arm64</ClayWindowsRid>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\native\clay\bin\$(ClayWindowsRid)\*.dll;..\..\native\clay\bin\*\*.so;..\..\native\clay\bin\*\*.dylib" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
