<Project Sdk="Microsoft.NET.Sdk">

  <!-- Prototype of ruin layouts: lays out one landmass's ruin with each layout model, maps every floor, and reports how
       long each step takes and how good each layout is; see Program.cs for how to run it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ClearSkies.Game\ClearSkies.Game.csproj" />
    <PackageReference Include="StbImageWriteSharp" Version="1.16.7" />
  </ItemGroup>

</Project>
